# ══════════════════════════════════════════════════════
# OpsPilot — .gitignore
# ══════════════════════════════════════════════════════

# ── Sécurité — NE JAMAIS COMMITTER ───────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
.venv/
pip-log.txt
*.egg-info/
dist/
build/
.pytest_cache/

# ── Node / Frontend ───────────────────────────────────
node_modules/
dist/
frontend/dist/
.npm
*.log
npm-debug.log*

# ── Données générées ──────────────────────────────────
rapports/
llm_memoire.json
*.db
*.sqlite

# ── IDE ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── ML Models ─────────────────────────────────────────
*.h5
*.keras
*.pkl
*.joblib
models/

# Données conversations (privées + pollués par les tests)
conversations.json

# Modèle LSTM PyTorch (trop lourd + régénéré automatiquement)
*.pt
lstm_ae_model.pt

# Résultats de tests
.coverage
resultats.txt
htmlcov/
coverage.xml

# Backup pytest créé par conftest.py
*.pytest_backup

# Fichiers temporaires Windows
*.tmp
desktop.ini